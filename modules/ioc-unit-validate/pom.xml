<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>net.oneandone.ioc-unit</groupId>
        <artifactId>ioc-unit-parent</artifactId>
        <version>5.0.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>ioc-unit-validate</artifactId>
    <packaging>jar</packaging>

    <name>net.oneandone.ioc-unit:ioc-unit-validate</name>
    <description>Allow the definition of beans as to be validated in the testcontainer</description>
    <url>https://github.com/1and1/modules/ioc-unit-validate</url>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <dependencies>
        <dependency>
            <groupId>net.oneandone.ioc-unit</groupId>
            <artifactId>weld-starter-base</artifactId>
            <version>${project.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <version>${junit5.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.oneandone.ioc-unit</groupId>
            <artifactId>ioc-unit</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- This module's whole purpose is to build a real jakarta.validation ValidatorFactory
             for standalone (non-container) tests, so hibernate-validator/-cdi are required at
             real (compile) scope for ioc-unit-validate itself to function. "provided" was
             previously used here to mirror the assumption that a real WildFly container
             supplies these, but that assumption breaks for weld-starter's standalone Weld SE
             bootstrap, where nothing else supplies them.
             Note "optional" is intentionally NOT used on hibernate-validator-cdi: an optional
             dependency never flows transitively regardless of scope, which would silently
             re-introduce this exact gap for any consumer.
             The EL stack itself (jakarta.el-api / org.glassfish:jakarta.el) is NOT declared
             here anymore: it is a runtime requirement of weld-web (pulled in by weld-starter,
             which this module already depends on transitively), not of ioc-unit-validate, so
             weld-starter now owns that dependency at compile scope instead. Declaring it here
             too was accidental coupling: consumers that dropped ioc-unit-validate lost their
             only source of a working jakarta.el implementation and failed with
             NoClassDefFoundError on org.jboss.weld.module.web.WeldWebModule. -->
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator-cdi</artifactId>
            <scope>compile</scope>
        </dependency>
        <!-- WildFly's own BOM wildcard-excludes ALL transitive dependencies of every artifact it
             manages, including hibernate-validator above - silently dropping classmate (a real
             transitive dependency of hibernate-validator, required by
             ValidatorFactoryImpl/TypeResolutionHelper to actually construct a ValidatorFactory).
             Without it, building a ValidatorFactory fails with NoClassDefFoundError:
             com/fasterxml/classmate/TypeResolver - but ONLY when nothing else on the classpath
             happens to also pull in classmate transitively (e.g. via ioc-unit-resteasy), which is
             why this was masked for a long time. Same root cause and same fix pattern already
             applied to ioc-unit-resteasy for reactive-streams/json-patch: declare it directly,
             with an explicit version, bypassing the excluded transitive edge entirely. -->
        <dependency>
            <groupId>com.fasterxml</groupId>
            <artifactId>classmate</artifactId>
            <version>1.5.1</version>
            <scope>compile</scope>
        </dependency>

        <!-- logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.oneandone.ioc-unit</groupId>
            <artifactId>weld-starter</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <redirectTestOutputToFile>true</redirectTestOutputToFile>

                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
