<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.oneandone.ioc-unit</groupId>
        <artifactId>ioc-unit-parent</artifactId>
        <version>6.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>weld-starter-parent</artifactId>
    <packaging>pom</packaging>
    <name>net.oneandone.ioc-unit:weld-starter-parent</name>
    <description>Parent for the weld-starter modules, which boot a standalone (non-container) Weld
        SE engine used to run ioc-unit tests. A true child of ioc-unit-parent (see the root
        README/pom for shared properties, plugin versions, release/distribution management, scm,
        etc. - not duplicated here to avoid the version drift this project previously had).
    </description>

    <!-- Everything else (licenses, developers, url, scm, issueManagement, inceptionYear,
         distributionManagement, release-sign-artifacts profile, and all plugin/property versions
         that matched the root pom's values) is inherited from ioc-unit-parent. Only entries
         genuinely unique to the weld-starter modules remain below. -->

    <dependencyManagement>
        <dependencies>
            <!-- jboss-classfilewriter (used by weld-starter-test) is not managed by
                 ioc-unit-parent; stays pinned here. -->
            <dependency>
                <groupId>org.jboss.classfilewriter</groupId>
                <artifactId>jboss-classfilewriter</artifactId>
                <version>1.2.5.Final</version>
                <scope>test</scope>
            </dependency>
            <!-- Now that this pom inherits ioc-unit-parent's dependencyManagement (which imports
                 the WildFly BOMs), jakarta.enterprise.cdi-api:4.0.1 transitively pulls
                 jakarta.el-api:5.0.0 - which conflicts with weld-starter's own explicit
                 jakarta.el-api:5.0.1 pin (needed for weld-web's WeldWebModule, see
                 weld-starter/pom.xml) and fails the inherited dependencyConvergence enforcer
                 rule. Pin jakarta.el-api here so the whole weld-starter subtree converges on one
                 version instead of each module resolving it independently. -->
            <dependency>
                <groupId>jakarta.el</groupId>
                <artifactId>jakarta.el-api</artifactId>
                <version>5.0.1</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-junit47</artifactId>
                        <version>${maven-surefire-plugin.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <systemPropertyVariables>
                        <javax.xml.parsers.DocumentBuilderFactory>
                            com.sun.org.apache.xerces.internal.jaxp.DocumentBuilderFactoryImpl
                        </javax.xml.parsers.DocumentBuilderFactory>
                    </systemPropertyVariables>

                    <reportFormat>plain</reportFormat>
                    <redirectTestOutputToFile>true</redirectTestOutputToFile>
                    <!-- Sets the VM argument line used when unit tests are run. -->
                    <argLine>
                        ${surefire-argline}
                    </argLine>
                    <forkCount>1</forkCount>
                    <reuseForks>false</reuseForks>
                    <classpathDependencyExcludes>
                        <classpathDependencyExclude>net.oneandone:purecdi-tests</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>weld-starter-base</module>
        <module>weld-starter</module>
        <module>weld-starter-test</module>
    </modules>

</project>
